    {
      "externalId": "chemistry-balance-001",
      "type": "single_choice",
      "subject": "chemistry",
      "topics": ["chemical-equations"],
      "difficulty": "easy",
      "stem": [
        {
          "type": "paragraph",
          "runs": [
            {
              "type": "text",
              "text": "Which equation correctly balances the formation of water from hydrogen and oxygen?"
            }
          ]
        }
      ],
      "options": [
        {
          "id": "opt-a",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "\\ce{H2 + O2 -> H2O}",
                  "spokenText": "Hydrogen plus oxygen yields water, with coefficients one, one, one."
                }
              ]
            }
          ]
        },
        {
          "id": "opt-b",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "\\ce{2H2 + O2 -> 2H2O}",
                  "spokenText": "Two hydrogen molecules plus one oxygen molecule yield two water molecules."
                }
              ]
            }
          ]
        },
        {
          "id": "opt-c",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "\\ce{H2 + 2O2 -> H2O}",
                  "spokenText": "Hydrogen plus two oxygen molecules yields water."
                }
              ]
            }
          ]
        },
        {
          "id": "opt-d",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "\\ce{2H2 + 2O2 -> H2O}",
                  "spokenText": "Two hydrogen molecules plus two oxygen molecules yield one water molecule."
                }
              ]
            }
          ]
        }
      ],
      "answer": {
        "correctOptionId": "opt-b"
      },
      "explanation": [
        {
          "type": "paragraph",
          "runs": [
            {
              "type": "text",
              "text": "The balanced equation conserves four hydrogen atoms and two oxygen atoms on each side."
            }
          ]
        },
        {
          "type": "display_math",
          "latex": "\\ce{2H2 + O2 -> 2H2O}",
          "spokenText": "Two hydrogen molecules react with one oxygen molecule to form two water molecules."
        }
      ],
      "source": {
        "kind": "original",
        "reference": "Illustrative example authored for the import-format specification; requires academic review before publication."
      }
