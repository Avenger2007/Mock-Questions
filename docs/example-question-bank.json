      "externalId": "math-derivative-001",
      "type": "single_choice",
      "subject": "mathematics",
      "topics": ["differentiation"],
      "difficulty": "easy",
      "stem": [
        {
          "type": "paragraph",
          "runs": [
            {
              "type": "text",
              "text": "For "
            },
            {
              "type": "math",
              "latex": "f(x)=x^2",
              "spokenText": "f of x equals x squared"
            },
            {
              "type": "text",
              "text": ", find "
            },
            {
              "type": "math",
              "latex": "f'(3)",
              "spokenText": "the derivative of f at three"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "options": [
        {
          "id": "opt-a",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "text",
                  "text": "3"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-b",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "text",
                  "text": "6"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-c",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "text",
                  "text": "9"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-d",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "text",
                  "text": "12"
                }
              ]
            }
          ]
        }
      ],
      "answer": {
        "correctOptionId": "opt-b"
      },
      "explanation": [
        {
          "type": "paragraph",
          "runs": [
            {
              "type": "text",
              "text": "Differentiate the function, then substitute x = 3."
            }
          ]
        },
        {
          "type": "display_math",
          "latex": "f'(x)=2x\\quad\\Rightarrow\\quad f'(3)=6",
          "spokenText": "f prime of x equals two x; therefore f prime of three equals six."
        }
      ],
      "source": {
