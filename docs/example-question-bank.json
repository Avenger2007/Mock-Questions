    {
      "externalId": "physics-energy-001",
      "type": "single_choice",
      "subject": "physics",
      "topics": ["kinetic-energy"],
      "difficulty": "easy",
      "stem": [
        {
          "type": "paragraph",
          "runs": [
            {
              "type": "text",
              "text": "A body of mass "
            },
            {
              "type": "math",
              "latex": "2\\,\\mathrm{kg}",
              "spokenText": "two kilograms"
            },
            {
              "type": "text",
              "text": " moves at "
            },
            {
              "type": "math",
              "latex": "3\\,\\mathrm{m\\,s^{-1}}",
              "spokenText": "three metres per second"
            },
            {
              "type": "text",
              "text": ". What is its kinetic energy?"
            }
          ]
        }
      ],
      "options": [
        {
          "id": "opt-a",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "3\\,\\mathrm{J}",
                  "spokenText": "three joules"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-b",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "6\\,\\mathrm{J}",
                  "spokenText": "six joules"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-c",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "9\\,\\mathrm{J}",
                  "spokenText": "nine joules"
                }
              ]
            }
          ]
        },
        {
          "id": "opt-d",
          "content": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "type": "math",
                  "latex": "18\\,\\mathrm{J}",
                  "spokenText": "eighteen joules"
                }
              ]
            }
          ]
        }
      ],
      "answer": {
        "correctOptionId": "opt-c"
      },
      "explanation": [
        {
          "type": "display_math",
          "latex": "K=\\frac{1}{2}mv^2=\\frac{1}{2}\\times2\\times3^2=9\\,\\mathrm{J}",
          "spokenText": "Kinetic energy equals one half mass times speed squared, giving nine joules."
        }
      ],
      "source": {
        "kind": "original",
        "reference": "Illustrative example authored for the import-format specification; requires academic review before publication."
      }
