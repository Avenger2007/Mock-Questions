      "id": "M25-01",
      "topic": "Algebra",
      "sub_topic": "Determinants",
      "difficulty": "easy",
      "question": "If A = [[3, 2], [1, 4]], what is |A|?",
      "options": [
        "A) 12",
        "B) 8",
        "C) 14",
        "D) 10"
      ],
      "correct_option": "D",
      "explanation": "|A| = (3)(4) - (2)(1) = 12 - 2 = 10."
    },
    {
      "id": "M25-02",
      "topic": "Algebra",
      "sub_topic": "Calculus",
      "difficulty": "easy",
      "question": "What is the derivative of f(x) = 7x\u00b3 - 4x\u00b2 + 2x - 5 at x = 1?",
      "options": [
        "A) 17",
        "B) 15",
        "C) 13",
        "D) 11"
      ],
      "correct_option": "B",
      "explanation": "f'(x) = 21x\u00b2 - 8x + 2. f'(1) = 21 - 8 + 2 = 15."
    },
    {
      "id": "M25-03",
      "topic": "Algebra",
      "sub_topic": "Matrices",
      "difficulty": "medium",
      "question": "Let A = [[2, 1], [3, 4]] and B = [[1, 0], [2, 1]]. What is the element in the second row, first column of AB?",
      "options": [
        "A) 11",
        "B) 8",
        "C) 10",
        "D) 4"
      ],
      "correct_option": "A",
      "explanation": "AB[2,1] = 3(1) + 4(2) = 3 + 8 = 11."
    },
    {
