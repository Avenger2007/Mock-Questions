    {
      "id": "P24_32",
      "topic": "Algebra",
      "sub_topic": "Calculus",
      "difficulty": "hard",
      "question": "The value of lim(x\u21920) (e\u02e3 - 1 - x)/x\u00b2 is:",
      "options": [
        "A) 1/2",
        "B) 2",
        "C) 0",
        "D) 1"
      ],
