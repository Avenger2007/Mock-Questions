    {
      "id": "P24_31",
      "topic": "Algebra",
      "sub_topic": "Matrices",
      "difficulty": "hard",
      "question": "If A = [[2, 1, 1], [1, 2, 1], [1, 1, 2]] and A\u207b\u00b9 = (1/k)[[a, b, b], [b, a, b], [b, b, a]], then k equals:",
