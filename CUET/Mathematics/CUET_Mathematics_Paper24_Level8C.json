    },
    {
      "id": "P24_33",
      "topic": "Algebra",
      "sub_topic": "Probability",
      "difficulty": "hard",
      "question": "Three boxes contain balls: Box I (2R,3B), Box II (3R,2B), Box III (4R,1B). A box is chosen at random and a red ball is drawn. What is the probability it came from Box III?",
      "options": [
        "A) 2/5",
        "B) 4/9",
        "C) 5/9",
        "D) 1/3"
      ],
      "correct_option": "B",
      "explanation": "P(Box III | Red) = P(Box III \u2229 Red)/P(Red) = (1/3 \u00d7 4/5) / [(1/3 \u00d7 2/5) + (1/3 \u00d7 3/5) + (1/3 \u00d7 4/5)] = (4/15) / (9/15) = 4/9."
    },
    {
      "id": "P24_34",
      "topic": "Algebra",
      "sub_topic": "Integration",
      "difficulty": "hard",
      "question": "The value of \u222b\u2080^\u03c0 x\u00b7sin(x)/(1 + cos\u00b2(x)) dx is:",
      "options": [
        "A) \u03c0\u00b2/4",
        "B) \u03c0\u00b2/2",
        "C) \u03c0/2",
        "D) \u03c0\u00b2/8"
